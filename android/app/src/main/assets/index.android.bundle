:'greek'}],e.TermsData=[{title:'1. Terms',content:'By accessing this website, you are agreeing to be bound by these website Terms and Conditions of Use, applicable laws and regulations and their compliance. If you disagree with any of the stated terms and conditions, you are prohibited from using or accessing this site. The materials contained in this site are secured by relevant copyright and trademark law.'},{title:'2. Use Licence',content:"Permission is allowed to temporarily download one duplicate of the materials (data or programming) on Company's site for individual and non-business use only. This is just a permit of license and not an exchange of title, and under this permit, you may not:\n\n\u2022 modify or copy the materials;\n\u2022 use the materials for any commercial use, or for any public presentation (business or non-business);\n\u2022 attempt to dec"},{title:'',content:"Permission is allowed to temporarily download one duplicate of the materials (data or programming) on Company's site for individual and non-business use only. This is just a permit of license and not an exchange of title, and under this permit, you may not:\n\n\u2022 modify or copy the materials;\n\u2022 use the materials for any commercial use, or for any public presentation (business or non-business);\n\u2022 attempt to dec"}],e.aboutUsData=[{title:'',content:'Welcome to Almax, your go-to fitness app designed to make staying active easier, more flexible, and more enjoyable than ever before.'},{title:'',content:'At Almax, we believe fitness should be accessible to everyone, no matter where you are or what your routine looks like. That\u2019s why we\u2019ve partnered with gyms and fitness studios across the country to bring you a wide variety of workouts, tailored to your preferences and schedule.'},{title:'',content:'Our mission is simple: to revolutionize the way you approach fitness by offering variety, affordability, and freedom, all in one app. Whether you\u2019re exploring new activities, sticking to your favorite classes, or looking for a fitness community, Almax makes it all possible.'},{title:'',content:'Join us and discover a new way to stay fit on your terms.'},{title:'Collective Guidelines',content:'To ensure a great experience for everyone, we kindly ask our users to keep these simple guidelines in mind:'},{title:'',content:'\u2022 Cancel Early When You Can: If you\u2019re unable to attend a workout, please cancel your booking as early as possible. This allows others to take advantage of the spot and helps our partner venues optimize their schedules.'},{title:'',content:'\u2022 Be Considerate: Fitness is about building a positive community. Let\u2019s respect the time and effort of other users and our venue partners by being on time, adhering to bookings and avoiding last-minute changes whenever possible.'},{title:'',content:'\u2022 Keep Exploring: Almax is designed to give you the freedom to try new workouts and venues. Make the most of your credits by diversifying your fitness routine and finding what works best for you.'}],e.FaqData=[{question:'How does Alma work?',answer:'Sign up, explore locations, book classes, and check in with the app. Enjoy seamless management of your fitness activities',expanded:!0},{question:'Can I cancel my membership?',answer:'',expanded:!1,answer:'Testing answers'},{question:'What membership plans are available?',answer:'',expanded:!1,answer:'No Answers added yet!'},{question:'How do I upgrade or downgrade my membership?',answer:'',expanded:!1,answer:'No Answers added yet!'},{question:'How do I book a class?',answer:'',expanded:!1,answer:'No Answers added yet!'},{question:'How can I enter the venue?',answer:'',expanded:!1,answer:'No Answers added yet!'}],e.SettingsData={'General Settings':[{title:'Edit Profile',showRadioButton:!1,navigationString:'EditProfile'},{title:'Change Password',showRadioButton:!1,navigationString:'ChangePassword'},{title:'Manage Membership',showRadioButton:!1,navigationString:'M